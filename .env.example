# Optional: leave all WA fields empty to keep WhatsApp intake disabled.
# Configure these only on your private server, never in frontend/VITE variables.
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_INBOX_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ALLOWED_SENDERS=
WA_TIMEZONE=Asia/Dhaka
# Mount a persistent private volume here when hosting; never put it in public/.
WA_INBOX_PATH=./data/whatsapp-inbox.sqlite
# Optional absolute executable path. English receipt OCR is local mode only.
TESSERACT_PATH=
