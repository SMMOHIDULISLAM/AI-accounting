# Optional: leave all WA fields empty to keep WhatsApp intake disabled.
# Configure these only on your private server, never in frontend/VITE variables.
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_INBOX_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ALLOWED_SENDERS=
WA_TIMEZONE=Asia/Dhaka
# Mount a persistent private volume here when hosting; never put it in public/.
WA_INBOX_PATH=./data/whatsapp-inbox.sqlite
# Optional absolute executable path. English receipt OCR is local mode only.
TESSERACT_PATH=

# Optional, single-company self-hosted Telegram intake. Keep secrets server-side.
TG_WEBHOOK_SECRET=
TG_INBOX_TOKEN=
TG_ALLOWED_CHAT_IDS=
TG_ALLOWED_USER_IDS=
TG_TIMEZONE=Asia/Dhaka
TG_INBOX_PATH=./data/telegram-inbox.sqlite
# Optional native engines; fixed, trusted executable paths managed by the owner.
PYTHON_EXECUTABLE=
JAVA_EXECUTABLE=
CPP_COST_ENGINE=
