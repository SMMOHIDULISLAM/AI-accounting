{
  "name": "ai-accounting",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/copy-wasm.mjs && node --env-file-if-exists=.env --import tsx server/index.ts",
    "local": "node scripts/copy-wasm.mjs && node --env-file-if-exists=.env --import tsx server/index.ts --local",
    "build": "node scripts/copy-wasm.mjs && vite build",
    "build:cloud": "node scripts/build-cloud.mjs",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts --production --local",
    "serve": "node --env-file-if-exists=.env --import tsx server/index.ts --production",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke-production.mjs",
    "edition:core": "node scripts/start-edition.mjs core",
    "edition:whatsapp": "node scripts/start-edition.mjs whatsapp",
    "free": "node scripts/start-edition.mjs whatsapp",
    "verify:sources": "node scripts/verify-vendored.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.5",
    "@fontsource/jetbrains-mono": "5.2.5",
    "@supabase/supabase-js": "2.119.2",
    "express": "4.22.3",
    "lucide-react": "0.468.0",
    "papaparse": "5.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sql.js": "1.17.0"
  },
  "devDependencies": {
    "@types/express": "4.17.23",
    "@types/node": "22.18.12",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.1.9",
    "@types/sql.js": "1.4.9",
    "fake-indexeddb": "6.2.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  },
  "engines": {
    "node": "^24.0.0"
  }
}
